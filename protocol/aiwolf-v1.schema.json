{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiwolf:protocol:1.0",
  "title": "AI Werewolf protocol envelope, version 1.0",
  "description": "Language-independent envelope definitions. Every message carries its full protocol version. During the connection handshake, the server compares major versions and rejects a mismatch; the session implementation performs that negotiation. This common schema identifies direction only by seq; message-type direction is declared by type-specific schemas.",
  "oneOf": [
    { "$ref": "#/$defs/client_request" },
    { "$ref": "#/$defs/server_event" }
  ],
  "$defs": {
    "message_type": {
      "type": "string",
      "minLength": 1
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "game_id": {
      "type": "string",
      "minLength": 1,
      "description": "An opaque non-empty identifier chosen by the authoritative game creator."
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "The complete major.minor protocol version, for example 1.0."
    },
    "payload": {
      "type": "object"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "Timestamp generated by the sender."
    },
    "client_timestamp": {
      "allOf": [
        { "$ref": "#/$defs/timestamp" }
      ],
      "description": "Client local timestamp for diagnostics. The server never uses it to decide game state or deadlines."
    },
    "server_timestamp": {
      "allOf": [
        { "$ref": "#/$defs/timestamp" }
      ],
      "description": "Server-authoritative timestamp."
    },
    "envelope": {
      "type": "object",
      "required": [
        "type",
        "protocol_version",
        "event_id",
        "game_id",
        "timestamp",
        "payload"
      ],
      "properties": {
        "type": { "$ref": "#/$defs/message_type" },
        "protocol_version": { "$ref": "#/$defs/protocol_version" },
        "event_id": { "$ref": "#/$defs/uuid" },
        "game_id": { "$ref": "#/$defs/game_id" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": { "$ref": "#/$defs/payload" }
      },
      "description": "Shared header declarations for strict directional variants."
    },
    "client_request": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "not": {
            "required": ["seq"]
          }
        },
        {
          "properties": {
            "timestamp": { "$ref": "#/$defs/client_timestamp" }
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "A strict client-to-server request. Requests omit seq. The common envelope does not assign individual message types to a direction."
    },
    "session_join_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "session.join" },
            "payload": {
              "type": "object",
              "required": ["player_id"],
              "properties": {
                "player_id": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Initial binding of one pre-registered, unbound game seat."
    },
    "session_resume_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "session.resume" },
            "payload": {
              "type": "object",
              "required": ["connection_token", "last_seq"],
              "properties": {
                "connection_token": { "type": "string", "minLength": 1 },
                "last_seq": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Reconnect by bearer token without resubmitting a player id."
    },
    "session_ready_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "session.ready" },
            "payload": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Mark the authenticated game seat as ready."
    },
    "chat_send_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "chat.send" },
            "payload": {
              "type": "object",
              "required": ["message"],
              "properties": {
                "message": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Send one message when the core exposes exactly one content-declared chat channel."
    },
    "vote_cast_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "vote.cast" },
            "payload": {
              "type": "object",
              "required": ["target_player_id"],
              "properties": {
                "target_player_id": { "type": ["string", "null"], "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Reserve or replace the authenticated player's vote. null is explicit abstention."
    },
    "ability_use_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "ability.use" },
            "payload": {
              "type": "object",
              "required": ["ability_id", "target_player_ids"],
              "properties": {
                "ability_id": { "type": "string", "minLength": 1 },
                "target_player_ids": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Reserve an ability action for the authenticated player."
    },
    "co_declare_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "co.declare" },
            "payload": {
              "type": "object",
              "required": ["claimed_role_id", "comment"],
              "properties": {
                "claimed_role_id": { "type": "string", "minLength": 1 },
                "comment": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Publicly claim a content-registered role. The core does not verify truth."
    },
    "co_report_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "co.report" },
            "payload": {
              "type": "object",
              "required": ["kind", "target_player_id", "claimed_result"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "target_player_id": { "type": "string", "minLength": 1 },
                "claimed_result": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Publicly report a claim. The core does not verify truth."
    },
    "action_rejected_payload": {
      "type": "object",
      "required": ["action", "reason"],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "A machine-readable rejection reason at a granularity a client can act on."
    },
    "game_event_payload": {
      "type": "object",
      "required": ["event_type", "event_payload"],
      "properties": {
        "event_type": { "type": "string", "minLength": 1 },
        "event_payload": { "type": "object" }
      },
      "additionalProperties": false,
      "description": "A public or recipient-private core event after server visibility filtering."
    },
    "chat_message_payload": {
      "type": "object",
      "required": ["channel", "message"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "message": { "type": "object" }
      },
      "additionalProperties": false,
      "description": "A chat payload sent only to the channel recipients authorized by content."
    },
    "server_event": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "required": ["seq"],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1,
              "description": "Game-wide server event sequence. It starts at 1 and has no gaps."
            },
            "timestamp": { "$ref": "#/$defs/server_timestamp" }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "action.rejected" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/action_rejected_payload" }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "A strict server-to-client event. seq is present only on this direction."
    },
    "session_joined_event": {
      "allOf": [
        { "$ref": "#/$defs/server_event" },
        {
          "properties": {
            "type": { "const": "session.joined" },
            "payload": {
              "type": "object",
              "required": ["player_id", "connection_token"],
              "properties": {
                "player_id": { "type": "string", "minLength": 1 },
                "connection_token": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Private direct reply carrying the newly issued connection token."
    },
    "session_resumed_event": {
      "allOf": [
        { "$ref": "#/$defs/server_event" },
        {
          "properties": {
            "type": { "const": "session.resumed" },
            "payload": {
              "type": "object",
              "required": ["player_id", "last_seq"],
              "properties": {
                "player_id": { "type": "string", "minLength": 1 },
                "last_seq": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Authenticated reconnect acknowledgement; state replay follows in Phase 2.5."
    },
    "session_ready_event": {
      "allOf": [
        { "$ref": "#/$defs/server_event" },
        {
          "properties": {
            "type": { "const": "session.ready" },
            "payload": {
              "type": "object",
              "required": ["player_id", "ready"],
              "properties": {
                "player_id": { "type": "string", "minLength": 1 },
                "ready": { "const": true }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Private direct acknowledgement for an authenticated ready request."
    },
    "game_event": {
      "allOf": [
        { "$ref": "#/$defs/server_event" },
        {
          "properties": {
            "type": { "const": "game.event" },
            "payload": { "$ref": "#/$defs/game_event_payload" }
          }
        }
      ],
      "description": "A versioned server envelope for one safe core event."
    },
    "chat_message": {
      "allOf": [
        { "$ref": "#/$defs/server_event" },
        {
          "properties": {
            "type": { "const": "chat.message" },
            "payload": { "$ref": "#/$defs/chat_message_payload" }
          }
        }
      ],
      "description": "A versioned server envelope for one content-authorized chat message."
    }
  }
}
