{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiwolf:protocol:1.0",
  "title": "AI Werewolf protocol envelope, version 1.0",
  "description": "Language-independent envelope definitions. Every message carries its full protocol version. During the connection handshake, the server compares major versions and rejects a mismatch; the session implementation performs that negotiation. This common schema identifies direction only by seq; message-type direction is declared by type-specific schemas.",
  "oneOf": [
    { "$ref": "#/$defs/client_request" },
    { "$ref": "#/$defs/server_event" }
  ],
  "$defs": {
    "message_type": {
      "type": "string",
      "minLength": 1
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "game_id": {
      "type": "string",
      "minLength": 1,
      "description": "An opaque non-empty identifier chosen by the authoritative game creator."
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "The complete major.minor protocol version, for example 1.0."
    },
    "payload": {
      "type": "object"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "Timestamp generated by the sender."
    },
    "client_timestamp": {
      "allOf": [
        { "$ref": "#/$defs/timestamp" }
      ],
      "description": "Client local timestamp for diagnostics. The server never uses it to decide game state or deadlines."
    },
    "server_timestamp": {
      "allOf": [
        { "$ref": "#/$defs/timestamp" }
      ],
      "description": "Server-authoritative timestamp."
    },
    "envelope": {
      "type": "object",
      "required": [
        "type",
        "protocol_version",
        "event_id",
        "game_id",
        "timestamp",
        "payload"
      ],
      "properties": {
        "type": { "$ref": "#/$defs/message_type" },
        "protocol_version": { "$ref": "#/$defs/protocol_version" },
        "event_id": { "$ref": "#/$defs/uuid" },
        "game_id": { "$ref": "#/$defs/game_id" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": { "$ref": "#/$defs/payload" }
      },
      "description": "Shared header declarations for strict directional variants."
    },
    "client_request": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "not": {
            "required": ["seq"]
          }
        },
        {
          "properties": {
            "timestamp": { "$ref": "#/$defs/client_timestamp" }
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "A strict client-to-server request. Requests omit seq. The common envelope does not assign individual message types to a direction."
    },
    "session_join_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "session.join" },
            "payload": {
              "type": "object",
              "required": ["player_id"],
              "properties": {
                "player_id": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Initial binding of one pre-registered, unbound game seat."
    },
    "session_resume_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "session.resume" },
            "payload": {
              "type": "object",
              "required": ["connection_token", "last_seq"],
              "properties": {
                "connection_token": { "type": "string", "minLength": 1 },
                "last_seq": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Reconnect by bearer token without resubmitting a player id."
    },
    "session_ready_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "session.ready" },
            "payload": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Mark the authenticated game seat as ready."
    },
    "chat_send_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "chat.send" },
            "payload": {
              "type": "object",
              "required": ["channel_id", "message"],
              "properties": {
                "channel_id": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Send one message to one content-declared chat channel."
    },
    "vote_cast_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "vote.cast" },
            "payload": {
              "type": "object",
              "required": ["target_player_id"],
              "properties": {
                "target_player_id": { "type": ["string", "null"], "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Reserve or replace the authenticated player's vote. null is explicit abstention."
    },
    "ability_use_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "ability.use" },
            "payload": {
              "type": "object",
              "required": ["ability_id", "target_player_ids"],
              "properties": {
                "ability_id": { "type": "string", "minLength": 1 },
                "target_player_ids": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Reserve an ability action for the authenticated player."
    },
    "co_declare_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "co.declare" },
            "payload": {
              "type": "object",
              "required": ["claimed_role_id", "comment"],
              "properties": {
                "claimed_role_id": { "type": "string", "minLength": 1 },
                "comment": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Publicly claim a content-registered role. The core does not verify truth."
    },
    "co_report_request": {
      "allOf": [
        { "$ref": "#/$defs/client_request" },
        {
          "properties": {
            "type": { "const": "co.report" },
            "payload": {
              "type": "object",
              "required": ["kind", "target_player_id", "claimed_result"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "target_player_id": { "type": "string", "minLength": 1 },
                "claimed_result": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Publicly report a claim. The core does not verify truth."
    },
    "action_rejected_payload": {
      "type": "object",
      "required": ["action", "reason"],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "A machine-readable rejection reason at a granularity a client can act on."
    },
    "game_event_payload": {
      "type": "object",
      "required": ["event_type", "event_payload"],
      "properties": {
        "event_type": { "type": "string", "minLength": 1 },
        "event_payload": { "type": "object" }
      },
      "additionalProperties": false,
      "description": "A public or recipient-private core event after server visibility filtering."
    },
    "chat_message_payload": {
      "type": "object",
      "required": ["channel", "message"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "message": { "type": "object" }
      },
      "additionalProperties": false,
      "description": "A chat payload sent only to the channel recipients authorized by content."
    },
    "player_list_payload": {
      "type": "object",
      "required": [
        "players"
      ],
      "properties": {
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "player_id",
              "display_name"
            ],
            "properties": {
              "player_id": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "player_deaths_payload": {
      "type": "object",
      "required": [
        "deaths"
      ],
      "properties": {
        "deaths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "player_id",
              "day"
            ],
            "properties": {
              "player_id": {
                "type": "string",
                "minLength": 1
              },
              "day": {
                "type": "integer",
                "minimum": 0
              },
              "public_cause": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "action_spec": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "ability_id",
            "description",
            "valid_targets",
            "target_count",
            "uses_remaining"
          ],
          "properties": {
            "type": {
              "const": "ability"
            },
            "ability_id": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "valid_targets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "target_count": {
              "type": "integer",
              "minimum": 1
            },
            "uses_remaining": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "channel"
          ],
          "properties": {
            "type": {
              "const": "chat"
            },
            "channel": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "valid_targets",
            "target_count",
            "allows_abstain"
          ],
          "properties": {
            "type": {
              "const": "vote"
            },
            "valid_targets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "target_count": {
              "const": 1
            },
            "allows_abstain": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "claimed_role_ids"
          ],
          "properties": {
            "type": {
              "const": "co_declare"
            },
            "claimed_role_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "co_report"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "player_action_state_payload": {
      "type": "object",
      "required": [
        "phase",
        "day",
        "phase_ends_at",
        "actions"
      ],
      "properties": {
        "phase": {
          "enum": [
            "setup",
            "night0",
            "dawn",
            "day",
            "vote",
            "runoff",
            "execution",
            "night",
            "game_end"
          ]
        },
        "day": {
          "type": "integer",
          "minimum": 0
        },
        "phase_ends_at": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action_spec"
          }
        }
      },
      "additionalProperties": false
    },
    "visible_history_entry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "payload"
          ],
          "properties": {
            "type": {
              "const": "game.event"
            },
            "payload": {
              "$ref": "#/$defs/game_event_payload"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "payload"
          ],
          "properties": {
            "type": {
              "const": "chat.message"
            },
            "payload": {
              "$ref": "#/$defs/chat_message_payload"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "game_state_sync_payload": {
      "type": "object",
      "required": [
        "players",
        "deaths",
        "action_state",
        "self",
        "revealed_roles",
        "history"
      ],
      "properties": {
        "players": {
          "$ref": "#/$defs/player_list_payload/properties/players"
        },
        "deaths": {
          "$ref": "#/$defs/player_deaths_payload/properties/deaths"
        },
        "action_state": {
          "$ref": "#/$defs/player_action_state_payload"
        },
        "self": {
          "type": "object",
          "required": [
            "player_id",
            "role_id",
            "modifier_ids"
          ],
          "properties": {
            "player_id": {
              "type": "string",
              "minLength": 1
            },
            "role_id": {
              "type": "string",
              "minLength": 1
            },
            "modifier_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "revealed_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "player_id",
              "role_id"
            ],
            "properties": {
              "player_id": {
                "type": "string",
                "minLength": 1
              },
              "role_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visible_history_entry"
          }
        }
      },
      "additionalProperties": false
    },
    "player_list_event": {
      "allOf": [
        {
          "$ref": "#/$defs/server_event"
        },
        {
          "properties": {
            "type": {
              "const": "player.list"
            },
            "payload": {
              "$ref": "#/$defs/player_list_payload"
            }
          }
        }
      ]
    },
    "player_deaths_event": {
      "allOf": [
        {
          "$ref": "#/$defs/server_event"
        },
        {
          "properties": {
            "type": {
              "const": "player.deaths"
            },
            "payload": {
              "$ref": "#/$defs/player_deaths_payload"
            }
          }
        }
      ]
    },
    "player_action_state_event": {
      "allOf": [
        {
          "$ref": "#/$defs/server_event"
        },
        {
          "properties": {
            "type": {
              "const": "player.action_state"
            },
            "payload": {
              "$ref": "#/$defs/player_action_state_payload"
            }
          }
        }
      ]
    },
    "game_state_sync_event": {
      "allOf": [
        {
          "$ref": "#/$defs/server_event"
        },
        {
          "properties": {
            "type": {
              "const": "game.state_sync"
            },
            "payload": {
              "$ref": "#/$defs/game_state_sync_payload"
            }
          }
        }
      ]
    },
    "server_event": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "required": ["seq"],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1,
              "description": "Per-player server event sequence, continued on resume. It starts at 1 and has no gaps."
            },
            "timestamp": { "$ref": "#/$defs/server_timestamp" }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "action.rejected" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/action_rejected_payload" }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "A strict server-to-client event. seq is present only on this direction."
    },
    "session_joined_event": {
      "allOf": [
        { "$ref": "#/$defs/server_event" },
        {
          "properties": {
            "type": { "const": "session.joined" },
            "payload": {
              "type": "object",
              "required": ["player_id", "connection_token"],
              "properties": {
                "player_id": { "type": "string", "minLength": 1 },
                "connection_token": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Private direct reply carrying the newly issued connection token."
    },
    "session_resumed_event": {
      "allOf": [
        { "$ref": "#/$defs/server_event" },
        {
          "properties": {
            "type": { "const": "session.resumed" },
            "payload": {
              "type": "object",
              "required": ["player_id", "last_seq"],
              "properties": {
                "player_id": { "type": "string", "minLength": 1 },
                "last_seq": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Authenticated reconnect acknowledgement, following missed events and preceding a full state sync."
    },
    "session_ready_event": {
      "allOf": [
        { "$ref": "#/$defs/server_event" },
        {
          "properties": {
            "type": { "const": "session.ready" },
            "payload": {
              "type": "object",
              "required": ["player_id", "ready"],
              "properties": {
                "player_id": { "type": "string", "minLength": 1 },
                "ready": { "const": true }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "description": "Private direct acknowledgement for an authenticated ready request."
    },
    "game_event": {
      "allOf": [
        { "$ref": "#/$defs/server_event" },
        {
          "properties": {
            "type": { "const": "game.event" },
            "payload": { "$ref": "#/$defs/game_event_payload" }
          }
        }
      ],
      "description": "A versioned server envelope for one safe core event."
    },
    "chat_message": {
      "allOf": [
        { "$ref": "#/$defs/server_event" },
        {
          "properties": {
            "type": { "const": "chat.message" },
            "payload": { "$ref": "#/$defs/chat_message_payload" }
          }
        }
      ],
      "description": "A versioned server envelope for one content-authorized chat message."
    }
  }
}
