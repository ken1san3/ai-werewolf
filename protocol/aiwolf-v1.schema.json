{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiwolf:protocol:1.0",
  "title": "AI Werewolf protocol envelope, version 1.0",
  "description": "Language-independent envelope definitions. Every message carries its full protocol version. During the connection handshake, the server compares major versions and rejects a mismatch; the session implementation performs that negotiation.",
  "oneOf": [
    { "$ref": "#/$defs/client_request" },
    { "$ref": "#/$defs/server_event" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "The complete major.minor protocol version, for example 1.0."
    },
    "envelope": {
      "type": "object",
      "required": [
        "type",
        "protocol_version",
        "event_id",
        "game_id",
        "timestamp",
        "payload"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "$ref": "#/$defs/protocol_version"
        },
        "event_id": {
          "$ref": "#/$defs/uuid"
        },
        "game_id": {
          "$ref": "#/$defs/uuid"
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "description": "Server-authoritative timestamp."
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "client_request": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "not": {
            "required": ["seq"]
          }
        },
        {
          "not": {
            "properties": {
              "type": { "const": "action.rejected" }
            },
            "required": ["type"]
          }
        }
      ],
      "description": "A client-to-server request. Requests never include seq."
    },
    "action_rejected_payload": {
      "type": "object",
      "required": ["action", "reason"],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "A machine-readable rejection reason at a granularity a client can act on."
    },
    "server_event": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "required": ["seq"],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1,
              "description": "Game-wide server event sequence. It starts at 1 and has no gaps."
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "action.rejected" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/action_rejected_payload" }
            }
          }
        }
      ],
      "description": "A server-to-client event. seq is present only on this direction."
    }
  }
}
